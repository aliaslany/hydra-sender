# Cloudflare Deployment Environment Variables
# Copy this file to .env.deploy and fill in your values:

# 1. Cloudflare API Token (Create at https://dash.cloudflare.com/profile/api-tokens with Workers & D1 edit permissions)
CLOUDFLARE_API_TOKEN="your_cloudflare_api_token"

# 2. Cloudflare Account ID (Found in Cloudflare Dashboard under Workers & Pages -> Account details)
CLOUDFLARE_ACCOUNT_ID="your_cloudflare_account_id"

# 3. Telegram Bot Token (From @BotFather)
BOT_TOKEN="your_telegram_bot_token"

# 4. Optional: Admin Dashboard password (auto-generated if left empty)
ADMIN_TOKEN=""

# 5. Optional: Webhook secret (auto-generated if left empty)
WEBHOOK_SECRET=""

# 6. Optional: Proxy relay (only if your Cloudflare worker cannot reach Divar directly)
DIVAR_PROXY_URL=""
DIVAR_PROXY_SECRET=""
